<mxfile host="app.diagrams.net"><diagram id="hf" name="Donation integration"><mxGraphModel dx="1400" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="820" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="&lt;b&gt;Heart Foundation - donation integration (proposed)&lt;/b&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:13px;color:#4b5563&amp;quot;&gt;Save first, process from a queue, retry what is temporary, escalate what is permanent, reconcile daily.&lt;/span&gt;" style="text;html=1;fontSize=22;align=left;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="25" y="20" width="1100" height="60" as="geometry"/></mxCell><mxCell id="container" value="Integration service" style="rounded=1;arcSize=4;dashed=1;fillColor=none;strokeColor=#1d4ed8;strokeWidth=2;fontColor=#1d4ed8;fontStyle=1;fontSize=16;align=right;verticalAlign=top;spacingRight=14;spacingTop=6;html=1;" vertex="1" parent="1"><mxGeometry x="25" y="240" width="1010" height="345" as="geometry"/></mxCell><mxCell id="web" value="&lt;b style=&quot;font-size:15px;color:#4b5563&quot;&gt;Website donation form&lt;/b&gt;&lt;br&gt;Next.js" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="pay" value="&lt;b style=&quot;font-size:15px;color:#4b5563&quot;&gt;Payment provider&lt;/b&gt;&lt;br&gt;approves the card payment" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f3f4f6;strokeColor=#4b5563;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="330" y="110" width="200" height="70" as="geometry"/></mxCell><mxCell id="recv" value="&lt;b style=&quot;font-size:15px;color:#1d4ed8&quot;&gt;1. Receive &amp; store&lt;/b&gt;&lt;br&gt;save first, reply 202&lt;br&gt;duplicate check on donationId" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="50" y="290" width="200" height="100" as="geometry"/></mxCell><mxCell id="queue" value="&lt;b style=&quot;font-size:15px;color:#1d4ed8&quot;&gt;2. Queue&lt;/b&gt;&lt;br&gt;absorbs campaign spikes&lt;br&gt;holds donations while&lt;br&gt;the CRM is down" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="290" y="290" width="180" height="100" as="geometry"/></mxCell><mxCell id="worker" value="&lt;b style=&quot;font-size:15px;color:#1d4ed8&quot;&gt;3. Validate, transform, send&lt;/b&gt;&lt;br&gt;check required fields, email, amount &amp;gt; 0&lt;br&gt;otherAmount → cents, UPPERCASE campaign&lt;br&gt;rate limited to 90 / min" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dbeafe;strokeColor=#1d4ed8;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="510" y="290" width="270" height="100" as="geometry"/></mxCell><mxCell id="crm" value="&lt;b style=&quot;font-size:15px;color:#6d28d9&quot;&gt;CRM&lt;/b&gt;&lt;br&gt;POST /api/donors&lt;br&gt;100 requests / min" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1080" y="290" width="220" height="100" as="geometry"/></mxCell><mxCell id="receipt" value="&lt;b style=&quot;font-size:15px;color:#6d28d9&quot;&gt;Tax receipt email&lt;/b&gt;&lt;br&gt;sent by CRM on 201" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ede9fe;strokeColor=#6d28d9;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="1080" y="110" width="220" height="70" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b style=&quot;font-size:15px;color:#b45309&quot;&gt;Response handling&lt;/b&gt;&lt;br&gt;201  delivered&lt;br&gt;409  already exists = success&lt;br&gt;401  refresh token, retry once&lt;br&gt;429  wait Retry-After, retry&lt;br&gt;5xx  backoff 1, 2, 4, 8, 16 s&lt;br&gt;400  no retry, send to review" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#b45309;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="510" y="430" width="270" height="130" as="geometry"/></mxCell><mxCell id="token" value="&lt;b style=&quot;font-size:15px;color:#15803d&quot;&gt;CRM auth&lt;/b&gt;&lt;br&gt;OAuth 2.0 client credentials&lt;br&gt;secret from a vault&lt;br&gt;refresh 5 min early&lt;br&gt;shared, not per request" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="810" y="430" width="170" height="130" as="geometry"/></mxCell><mxCell id="fail" value="&lt;b style=&quot;font-size:15px;color:#b91c1c&quot;&gt;Review &amp; dead-letter queue&lt;/b&gt;&lt;br&gt;400 bad data → Supporter Care fixes and replays&lt;br&gt;5xx still failing after 5 retries → replay later&lt;br&gt;nothing is dropped silently" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#b91c1c;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="50" y="445" width="420" height="100" as="geometry"/></mxCell><mxCell id="alert" value="&lt;b style=&quot;font-size:15px;color:#15803d&quot;&gt;Monitoring &amp; alerts&lt;/b&gt;&lt;br&gt;structured log per donation&lt;br&gt;alert: failed item, 5xx spike,&lt;br&gt;queue growing, token errors&lt;br&gt;dashboard: delivered / pending / failed" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="50" y="640" width="300" height="105" as="geometry"/></mxCell><mxCell id="sec" value="&lt;b style=&quot;font-size:15px;color:#15803d&quot;&gt;Security &amp; privacy&lt;/b&gt;&lt;br&gt;HTTPS only, signed website requests&lt;br&gt;secrets in a vault, never in code&lt;br&gt;logs use donationId, email masked&lt;br&gt;store minimum, delete once delivered" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="380" y="640" width="300" height="105" as="geometry"/></mxCell><mxCell id="recon" value="&lt;b style=&quot;font-size:15px;color:#15803d&quot;&gt;Daily reconciliation&lt;/b&gt;&lt;br&gt;payment approvals vs CRM records&lt;br&gt;match donationId, count and $ total&lt;br&gt;mismatch → alert + replay missing" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#15803d;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=12;fontColor=#1f2937;" vertex="1" parent="1"><mxGeometry x="710" y="640" width="310" height="105" as="geometry"/></mxCell><mxCell id="e0" value="card payment" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="pay"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e1" value="approved donation (HTTPS)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="web" target="recv"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="recv" target="queue"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="queue" target="worker"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e4" value="POST /api/donors" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="worker" target="crm"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e5" value="on 201" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crm" target="receipt"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e6" value="token" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#15803d;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="token" target="worker"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="895" y="365"/></Array></mxGeometry></mxCell><mxCell id="e7" value="response" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#374151;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="crm" target="rules"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1190" y="418"/><mxPoint x="795" y="418"/><mxPoint x="795" y="495"/></Array></mxGeometry></mxCell><mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b91c1c;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="rules" target="fail"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e9" value="alert" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#b91c1c;exitX=0.357;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="fail" target="alert"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e10" value="CRM records" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4b5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="crm" target="recon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1340" y="340"/><mxPoint x="1340" y="692"/></Array></mxGeometry></mxCell><mxCell id="e11" value="payment approvals" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#4b5563;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.926;entryY=0;entryDx=0;entryDy=0;fontSize=11;fontColor=#4b5563;labelBackgroundColor=#ffffff;dashed=1;" edge="1" parent="1" source="pay" target="recon"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="997" y="145"/></Array></mxGeometry></mxCell><mxCell id="legend" value="Solid = normal flow  ·  Dashed red = failure path  ·  Dashed grey = daily check" style="text;html=1;fontSize=12;fontColor=#4b5563;align=left;" vertex="1" parent="1"><mxGeometry x="25" y="760" width="700" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>